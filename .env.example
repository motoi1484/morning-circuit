# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Cloud Text-to-Speech ---
# Path to the service-account JSON key file (for local runs).
# In GitHub Actions this is written from the GCP_SA_KEY secret automatically.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Podcast feed ---
# Public base URL where docs/ is served (GitHub Pages URL, with trailing slash).
# Example: https://<your-user>.github.io/<repo>/
PODCAST_BASE_URL=https://example.github.io/listeningApp/

# --- Optional knobs ---
# Narration model (default: claude-opus-4-8). Switch to claude-sonnet-4-6 or
# claude-haiku-4-5 to cut cost if desired.
CLAUDE_MODEL=claude-opus-4-8
# Target word count for the ~30 min script (≈150 wpm).
TARGET_WORDS=4300
# Number of episodes to keep in the repo / feed.
KEEP_EPISODES=14
# Google TTS voice + speaking rate.
TTS_VOICE=en-US-Neural2-D
TTS_RATE=1.0
